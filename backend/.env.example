# MindMesh Environment Variables

PROJECT_NAME=MindMesh
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=false

# Database Configuration (PostgreSQL in production; SQLite supported for local testing/dev)
DATABASE_URL=sqlite:///./mindmesh.db

# Security & Tokens
SECRET_KEY=dev-insecure-secret-key-change-in-production-never-commit-actual-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Diagnostic & Retest Bank Settings
MIN_QUESTIONS_PER_CONCEPT=5
MIN_RETEST_ITEMS_PER_CONCEPT=2

# LLM Configuration (Disabled by default, strict structured output only if enabled)
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_API_KEY=
